# Copia questo file in ".env" (stessa cartella) e sostituisci i placeholder
# con le tue chiavi reali. Il file ".env" NON va committato: aggiungilo a
# .gitignore se non c'e' gia'.

# Alpha Vantage - fonte primaria per i fondamentali (config/sources.yaml).
# Chiave gratuita: https://www.alphavantage.co/support/#api-key
# Piano gratuito: 25 richieste/giorno, 5/minuto.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub - fallback per i fondamentali quando Alpha Vantage fallisce o ha
# esaurito la quota giornaliera.
# Chiave gratuita: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here
